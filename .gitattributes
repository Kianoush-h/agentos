# Force LF line endings for all shell scripts and text files
# Prevents Windows CRLF from breaking scripts on Linux/WSL2

* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.template text eol=lf
Makefile text eol=lf

# AppArmor profiles (no extension)
config/apparmor/* text eol=lf

# Binary files — no line ending conversion
*.ova binary
*.qcow2 binary
*.vmdk binary
*.raw binary
*.png binary
*.jpg binary
*.ico binary
